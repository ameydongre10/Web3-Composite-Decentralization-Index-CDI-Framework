# ==============================================================================
# Web3 Composite Decentralization Index (CDI) Framework - Environment Variables
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="Web3 Composite Decentralization Index (CDI) Framework"
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Database Configuration
# Local SQLite Async (Zero Configuration Default):
DATABASE_URL=sqlite+aiosqlite:///./cdi_framework.db
# Production PostgreSQL Async:
# DATABASE_URL=postgresql+asyncpg://cdi_user:cdi_secret_password@localhost:5432/cdi_db

# Security & Access Control
# Change this secret in production environments!
SECRET_KEY=cdi-production-secret-key-change-in-prod-2026
ADMIN_API_KEY=cdi-admin-key-2026
RATE_LIMIT_PER_MINUTE=120

# Blockchain RPC & Indexer Integrations
ETHEREUM_RPC_URL=https://cloudflare-eth.com
GANACHE_RPC_URL=http://127.0.0.1:8545
SNAPSHOT_GRAPHQL_URL=https://hub.snapshot.org/graphql
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Ingestion Scheduling
SYNC_INTERVAL_SECONDS=60
DEFAULT_LOOKBACK_DAYS=90
